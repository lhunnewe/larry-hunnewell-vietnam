---
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search engines (it stays reachable by direct URL). */
  noindex?: boolean;
}

const { title, description = 'The Vietnam service of Larry Dennis Hunnewell, 1964-1965. A family memoir and historical research archive.', noindex = false } = Astro.props;

// The public site is held to the pictures and his words until his service
// file comes back (SF-180, mailed 2026-08-17). The story, timeline, people,
// places, units, research, sources and glossary pages are parked as
// src/pages/_*.astro, which Astro does not build; renaming one back restores
// it. See CLAUDE.md, "The minimal site".
const nav = [
  { href: '/', label: 'Home' },
  { href: '/photos/', label: 'Photographs' },
  { href: '/footage/', label: 'Footage' },
  { href: '/drawings/', label: 'Drawings' },
  { href: '/memories/', label: 'Tell a Story' },
];

const currentPath = Astro.url.pathname;
function isCurrent(href: string): boolean {
  const full = withBase(href);
  if (href === '/') return currentPath === full || currentPath === `${full}/` || currentPath === withBase('');
  return currentPath.startsWith(full);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title === 'My Father in Vietnam' ? title : `${title} — My Father in Vietnam`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="masthead">
        <a class="site-title" href={withBase('/')}>
          <span class="site-name">My Father in Vietnam</span>
          <span class="site-sub record">Larry Dennis Hunnewell &middot; U.S. Army &middot; Vietnam, 1964 &ndash; 1965</span>
        </a>
      </div>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="record">
        A family history project &middot; memories preserved as given
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 2px solid var(--ink);
  }

  .masthead {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 1.6rem 1.25rem 1.1rem;
  }

  .site-title {
    text-decoration: none;
    color: var(--ink);
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .site-name {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.45rem;
    line-height: 1;
  }

  .site-title:hover .site-name {
    color: var(--signal);
  }

  nav {
    border-top: 1px solid var(--line);
    background: var(--paper-deep);
  }

  nav ul {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0 1.25rem;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.4rem;
  }

  nav a {
    display: inline-block;
    padding: 0.55rem 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 3px solid transparent;
  }

  nav a:hover {
    color: var(--signal);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 1.6rem 1.25rem 2.2rem;
    max-width: var(--wide);
    margin: 0 auto;
    width: 100%;
  }

  .site-footer p {
    margin: 0 0 0.4rem;
    text-transform: none;
    letter-spacing: 0.04em;
  }
</style>
