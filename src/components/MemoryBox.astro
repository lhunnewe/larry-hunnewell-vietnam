---
/**
 * Comment box backed by GitHub Discussions (giscus), written large and plain so
 * Larry can leave memories directly on a page. The discussion is keyed to a
 * stable term (the archive ID), never the URL, so threads survive URL changes
 * and the recollection exporter can match them back to catalog records.
 */
import { giscus } from '../lib/giscus';

interface Props {
  /** Stable discussion key, e.g. a photo's archive ID like "VN-0042" or "place:nui-ba-den". */
  term: string;
  /** What the page shows, used in the explainer sentence ("this photograph", "this place"). */
  subject?: string;
  /** Replaces the standard "If this X brings something back" explainer sentence. */
  intro?: string;
  /**
   * Image to keep pinned on screen while writing, so Larry can see what he's
   * commenting on after the page's main image scrolls away. Usually the same
   * URL as the page's full image — the browser has it cached already.
   */
  image?: string;
  imageAlt?: string;
}

const { term, subject = 'photograph', intro, image, imageAlt } = Astro.props;
---

<section class="memory-box" aria-label="Share what you remember">
  <h2>Share what you remember</h2>
  {
    intro ? (
      <p>{intro}</p>
    ) : (
      <p>
        If this {subject} brings something back, type it in the box below and press the
        <strong>Comment</strong> button. Anything helps — who was there, where it was, what
        was going on, or the story around it. Your words will be saved with this page.
      </p>
    )
  }
  <p>
    You don't have to type: tap in the box, then tap the <strong>microphone on the
    keyboard</strong> and just talk — the words will appear as you speak.
  </p>
  <p class="signin-note">
    If it asks you to <strong>sign in</strong>, stop and call the family for help — there is
    no need to make an account.
  </p>
  {image && <img class="pinned-subject" src={image} alt={imageAlt ?? ''} loading="lazy" />}
  <div class="giscus"></div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={giscus.repo}
    data-repo-id={giscus.repoId}
    data-category={giscus.category}
    data-category-id={giscus.categoryId}
    data-mapping="specific"
    data-term={term}
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="en"
    crossorigin="anonymous"
    async></script>
  <noscript>
    <p>The comment box needs JavaScript turned on. Ask the family for help with that.</p>
  </noscript>
</section>

<style>
  .memory-box {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
    max-width: var(--measure);
  }

  .memory-box p {
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .signin-note {
    color: var(--ink-soft);
  }

  .giscus {
    margin-top: 1.5rem;
  }

  /*
   * Stays pinned to the top of the screen while the comment area scrolls,
   * so the photograph is always in view as Larry writes about it. Sticky
   * within .memory-box only — it releases when the section ends.
   */
  .pinned-subject {
    position: sticky;
    top: 0.75rem;
    z-index: 5;
    display: block;
    margin: 1.25rem auto 0;
    max-width: 100%;
    max-height: 34vh;
    width: auto;
    border: 1px solid var(--ink);
    background: var(--paper);
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.3);
  }
</style>
