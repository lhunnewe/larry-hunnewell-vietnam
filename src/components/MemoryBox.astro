---
/**
 * Comment box backed by GitHub Discussions (giscus), written large and plain so
 * Larry can leave memories directly on a page. The discussion is keyed to a
 * stable term (the archive ID), never the URL, so threads survive URL changes
 * and the recollection exporter can match them back to catalog records.
 */
import { giscus } from '../lib/giscus';

interface Props {
  /** Stable discussion key, e.g. a photo's archive ID like "VN-0042" or "place:nui-ba-den". */
  term: string;
  /** What the page shows, used in the explainer sentence ("this photograph", "this place"). */
  subject?: string;
}

const { term, subject = 'photograph' } = Astro.props;
---

<section class="memory-box" aria-label="Share what you remember">
  <h2>Share what you remember</h2>
  <p>
    If this {subject} brings something back, type it in the box below and press the
    <strong>Comment</strong> button. Anything helps — who was there, where it was, what was
    going on, or the story around it. Your words will be saved with this page.
  </p>
  <p class="signin-note">
    If it asks you to <strong>sign in</strong>, stop and call the family for help — there is
    no need to make an account.
  </p>
  <div class="giscus"></div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={giscus.repo}
    data-repo-id={giscus.repoId}
    data-category={giscus.category}
    data-category-id={giscus.categoryId}
    data-mapping="specific"
    data-term={term}
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="en"
    crossorigin="anonymous"
    async></script>
  <noscript>
    <p>The comment box needs JavaScript turned on. Ask the family for help with that.</p>
  </noscript>
</section>

<style>
  .memory-box {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
    max-width: var(--measure);
  }

  .memory-box p {
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .signin-note {
    color: var(--ink-soft);
  }

  .giscus {
    margin-top: 1.5rem;
  }
</style>
