---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Recollection from '../../components/Recollection.astro';
import MemoryBox from '../../components/MemoryBox.astro';
import { withBase } from '../../lib/paths';
import {
  attributionFor,
  attributionForCopiedText,
  recordedLine,
  shownRecollections,
} from '../../lib/testimony';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((place) => ({ params: { id: place.id }, props: { place } }));
}

const { place } = Astro.props;
const d = place.data;

/** Every recollection, so copied testimony can be attributed by its true fidelity. */
const allRecollections = await getCollection('recollections');

/** Testimony about this place, minus anything under a hold. */
const placeRecollections = shownRecollections(allRecollections).filter((r) =>
  (r.data.relatedPlaces ?? []).some((p) => p.id === place.id)
);

/**
 * People for this place, from both directions: the place's own relatedPeople
 * and every person whose relatedPlaces lists it. Names, not slugs.
 */
const people = await getCollection('people');
const personIds = new Set([
  ...d.relatedPeople.map((p) => p.id),
  ...people.filter((pe) => pe.data.relatedPlaces.some((x) => x.id === place.id)).map((pe) => pe.id),
]);
const placePeople = people
  .filter((pe) => personIds.has(pe.id))
  .sort((a, b) =>
    a.id === 'larry-dennis-hunnewell' ? -1 : b.id === 'larry-dennis-hunnewell' ? 1 : a.data.name.localeCompare(b.data.name)
  );

const placePhotos = (await getCollection('photos'))
  .filter((p) => p.data.location?.id === place.id)
  .sort((a, b) => a.data.photoId.localeCompare(b.data.photoId));

/** Drawings whose sheet shows this place, in Larry's own hand. */
const placeDrawings = (await getCollection('drawings'))
  .filter((dr) => dr.data.depicts?.id === place.id)
  .sort((a, b) => a.data.drawingId.localeCompare(b.data.drawingId));

// Held to the name, his words, the people and pictures tied to the place, and
// the comment box while the site is minimal. The summary, research notes,
// evidence badge, citations, provenance and timeline stay on the record in
// data/places/ and do not render; the timeline is a parked section and is not
// linked. scripts/check-published.mjs treats places `summary` and
// `researchNotes` as parked fields. See CLAUDE.md, "The minimal site".
---

<BaseLayout title={d.name}>
  <span class="eyebrow">Place</span>
  <h1>{d.name}</h1>

  {d.alternateNames.length > 0 && (
    <p class="record">Also: {d.alternateNames.join(' · ')}</p>
  )}
  {d.coordinates && (
    <p class="record">
      {Math.abs(d.coordinates.lat).toFixed(4)}&deg;{d.coordinates.lat >= 0 ? 'N' : 'S'}{' '}
      {Math.abs(d.coordinates.lng).toFixed(4)}&deg;{d.coordinates.lng >= 0 ? 'E' : 'W'}
    </p>
  )}

  {d.larrysRecollection && (
    <Recollection attribution={attributionForCopiedText(d.larrysRecollection, allRecollections)}>
      {d.larrysRecollection}
    </Recollection>
  )}

  {placeRecollections.map((rec) => (
    <>
      <Recollection attribution={attributionFor(rec.data.fidelity)}>{rec.data.text}</Recollection>
      <p class="record provenance">{recordedLine(rec.data.recorded)}</p>
    </>
  ))}

  {!d.larrysRecollection && placeRecollections.length === 0 && (
    <p class="empty-state">Nothing has been written about this place yet.</p>
  )}

  {placePeople.length > 0 && (
    <>
      <h2>People</h2>
      <ul>
        {placePeople.map((pe) => (
          <li><a href={withBase(`/people/${pe.id}/`)}>{pe.data.name}</a></li>
        ))}
      </ul>
    </>
  )}

  {placePhotos.length > 0 && (
    <>
      <h2>Photographs</h2>
      <ul class="place-photos">
        {placePhotos.map((photo) => (
          <li>
            <a href={withBase(`/photos/${photo.id}/`)}>
              <img
                src={withBase(`/images/photos/thumbs/${photo.data.photoId}.jpg`)}
                alt={photo.data.cataloged ? photo.data.title : `Photograph ${photo.data.photoId}`}
                width="320"
                height="216"
                loading="lazy"
              />
              <span class="record">{photo.data.photoId}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  {placeDrawings.length > 0 && (
    <>
      <h2>Drawn from memory</h2>
      <ul class="place-drawings">
        {placeDrawings.map((dr) => (
          <li>
            <a href={withBase(`/drawings/${dr.id}/`)}>
              <img
                src={withBase(`/images/drawings/thumbs/${dr.data.drawingId}.jpg`)}
                alt=""
                width="320"
                height="240"
                loading="lazy"
              />
              <span class="record">{dr.data.drawingId}</span>
              <span class="drawing-title">{dr.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  <p><a href={withBase('/places/')}>&larr; All places</a></p>

  <MemoryBox term={`place:${place.id}`} subject="place" />
</BaseLayout>

<style>
  .provenance {
    margin: 0.3rem 0 1.4rem;
    color: var(--ink-soft);
  }

  .place-photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 1rem;
  }

  .place-photos img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  .place-drawings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .place-drawings a {
    text-decoration: none;
  }

  .place-drawings img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    margin-bottom: 0.3rem;
  }

  .drawing-title {
    display: block;
    font-size: 0.92rem;
    color: var(--ink);
  }
</style>
