---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Recollection from '../../components/Recollection.astro';
import MemoryBox from '../../components/MemoryBox.astro';
import { withBase } from '../../lib/paths';
import { attributionFor, attributionForCopiedText, recordedLine, shownRecollections } from '../../lib/testimony';

export async function getStaticPaths() {
  const photos = (await getCollection('photos')).sort((a, b) =>
    a.data.photoId.localeCompare(b.data.photoId)
  );
  return photos.map((photo, i) => ({
    params: { id: photo.id },
    props: {
      photo,
      prev: i > 0 ? photos[i - 1] : null,
      next: i < photos.length - 1 ? photos[i + 1] : null,
    },
  }));
}

const { photo, prev, next } = Astro.props;
const d = photo.data;
/** Every recollection, so copied testimony can be attributed by its true fidelity. */
const allRecollections = await getCollection("recollections");

/** Testimony recorded about this photograph, with its own fidelity and provenance. */
const photoRecollections = shownRecollections(allRecollections).filter((r) =>
  (r.data.relatedPhotos ?? []).some((x) => x.id === photo.id)
);
const heading = d.cataloged ? d.title : `Photograph ${d.photoId}`;
---

<BaseLayout title={`${d.photoId} — ${heading}`}>
  <span class="eyebrow">Photograph {d.photoId}</span>
  <h1>{heading}</h1>

  {d.originalPath && (
    <img
      src={withBase(`/images/photos/full/${d.photoId}.jpg`)}
      alt={d.cataloged ? d.title : `Photograph ${d.photoId}`}
      width="1600"
      height="1081"
    />
  )}

  <nav class="pager record" aria-label="Photograph navigation">
    {prev ? <a href={withBase(`/photos/${prev.id}/`)}>&larr; {prev.data.photoId}</a> : <span></span>}
    <a href={withBase('/photos/')}>All photographs</a>
    {next ? <a href={withBase(`/photos/${next.id}/`)}>{next.data.photoId} &rarr;</a> : <span></span>}
  </nav>

  {/*
    Held to the picture and his words until his service file comes back:
    no description, date, place, people, evidence badge or research notes
    render here. They stay on the record in data/photos/. See CLAUDE.md,
    "The minimal site".
  */}

  {d.larrysRecollection && (
    <Recollection attribution={attributionForCopiedText(d.larrysRecollection, allRecollections)}>
      {d.larrysRecollection}
    </Recollection>
  )}

  {photoRecollections.map((rec) => (
    <>
      <Recollection attribution={attributionFor(rec.data.fidelity)}>{rec.data.text}</Recollection>
      <p class="record provenance">{recordedLine(rec.data.recorded)}</p>
    </>
  ))}

  {!d.larrysRecollection && photoRecollections.length === 0 && (
    <p class="empty-state">Nothing has been written about this photograph yet.</p>
  )}

  <MemoryBox
    term={d.photoId}
    image={d.originalPath ? withBase(`/images/photos/full/${d.photoId}.jpg`) : undefined}
    imageAlt={d.cataloged ? d.title : `Photograph ${d.photoId}`}
  />
</BaseLayout>

<style>
  img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem 0 0.8rem;
    border: 1px solid var(--line);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
</style>
