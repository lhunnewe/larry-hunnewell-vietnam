---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoTile from '../../components/PhotoTile.astro';

// Held to one grid in archive-number order until his service file comes back.
// The grouped views (family sorting, location, person, date, catalog state)
// placed photographs by record fields that are parked for now; they are in git
// history and src/lib/photo-views.ts is kept for when they return. See
// CLAUDE.md, "The minimal site".
const photos = (await getCollection('photos')).sort((a, b) =>
  a.data.photoId.localeCompare(b.data.photoId)
);
---

<BaseLayout title="Photographs">
  <h1>Photographs</h1>
  <p class="lede">
    The {photos.length} photographs Larry brought home from Vietnam, each with its own number,
    from <span class="record">VN-0001</span> to <span class="record">VN-0157</span>. Open any
    photograph to see what he has said about it, or to add a memory.
  </p>

  <ul class="photo-grid">
    {photos.map((photo) => <PhotoTile photo={photo} />)}
  </ul>
</BaseLayout>

<style>
  .lede {
    font-size: 1.15rem;
  }

  .photo-grid {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
  }
</style>
