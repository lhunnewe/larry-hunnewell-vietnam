---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Recollection from '../components/Recollection.astro';
import MemoryBox from '../components/MemoryBox.astro';
import { withBase } from '../lib/paths';
import {
  attributionFor,
  attributionForCopiedText,
  recordedLine,
  shownRecollections,
} from '../lib/testimony';

/*
  Parked 2026-09-14 (research/site-audit-2026-09-14.md, "/timeline/"); rebuilt the same day to
  the minimal-site rules so restoring it is a rename plus the steps in CLAUDE.md.

  What renders: each event's title, display date and date precision; Larry's recollections
  linked to it (holds respected, recorded date only, no provenance); and thumbnails of the
  photographs the event names. What does not: researchNotes, evidence badges, citations,
  places and people (their pages are parked), and photographs placed by their own sortDate —
  photo dates are withheld on the minimal site, and some are answers still to be asked for.

  Descriptions are written to be public but stay off while scripts/check-published.mjs lists
  timeline `description` in PARKED_FIELDS. To show them, set SHOW_DESCRIPTIONS and remove that
  entry in the same change.
*/
const SHOW_DESCRIPTIONS = false;

const CATEGORY_META: Record<string, { label: string; color: string }> = {
  'larry-movement': { label: "Larry's movements", color: 'var(--olive)' },
  'larry-recollection': { label: "Larry's recollections", color: 'var(--signal)' },
  photo: { label: 'Photographs', color: 'var(--map-blue)' },
  'unit-event': { label: 'Unit events', color: 'var(--ev-strong)' },
  'war-event': { label: 'The war around him', color: 'var(--ink-soft)' },
  'research-discovery': { label: 'Research discoveries', color: 'var(--ev-plausible)' },
};

const allRecollections = await getCollection('recollections');
const shown = shownRecollections(allRecollections);
const photosById = new Map((await getCollection('photos')).map((p) => [p.id, p]));

const normalize = (text: string) => text.replace(/\s+/g, ' ').trim().toLowerCase();

const events = (await getCollection('timeline')).sort(
  (a, b) => a.data.sortDate.localeCompare(b.data.sortDate) || a.id.localeCompare(b.id)
);

/**
 * Testimony for each event, rendered once per page: a recollection linked to two events
 * shows under the first, and a block whose words are already on the page (a copied
 * larrysRecollection, or the same text on two records) is not repeated.
 */
const seenIds = new Set<string>();
const seenTexts: string[] = [];
const alreadyShown = (text: string) => {
  const n = normalize(text);
  return seenTexts.some((s) => s === n || (n.length >= 40 && s.includes(n)));
};

const entries = events.map((event) => {
  const recollections = shown.filter((r) => {
    if (!(r.data.relatedTimeline ?? []).some((x) => x.id === event.id)) return false;
    if (seenIds.has(r.id) || alreadyShown(r.data.text)) return false;
    seenIds.add(r.id);
    seenTexts.push(normalize(r.data.text));
    return true;
  });

  // Copied testimony on the event itself, only if none of the shown records already carries it.
  // A copy of a held recollection must not render either.
  const own = event.data.larrysRecollection;
  const copiesHeld =
    own !== undefined &&
    allRecollections.some((r) => r.data.hold && normalize(r.data.text).includes(normalize(own)));
  const ownText = own && !copiesHeld && !alreadyShown(own) ? own : undefined;
  if (ownText) seenTexts.push(normalize(ownText));

  const photos = event.data.relatedPhotos
    .map((ref) => photosById.get(ref.id))
    .filter((p): p is NonNullable<typeof p> => p !== undefined);

  return { event, recollections, ownText, photos };
});

const usedCategories = [...new Set(events.map((e) => e.data.category))];
const categoryCounts = new Map<string, number>();
for (const e of events) categoryCounts.set(e.data.category, (categoryCounts.get(e.data.category) ?? 0) + 1);
---

<BaseLayout title="Timeline">
  <span class="eyebrow">1963 &ndash; 1965</span>
  <h1>Timeline</h1>
  <p class="lede">
    Larry's time in the Army in order: where he went, what he remembers, and what the war was
    doing around him. Dates that come from memory are marked approximate or unknown.
  </p>
  <p>
    His own words are with the <a href={withBase('/photos/')}>photographs</a>, the
    <a href={withBase('/footage/')}>film</a> and the <a href={withBase('/drawings/')}>drawings</a>.
  </p>

  <ul class="legend record" aria-label="Timeline categories">
    {usedCategories.map((cat) => (
      <li><span class="swatch" style={`background:${CATEGORY_META[cat].color}`}></span>{CATEGORY_META[cat].label}</li>
    ))}
  </ul>

  <div class="filters record" role="group" aria-label="Filter timeline by category" hidden>
    <button type="button" data-all aria-pressed="true">All</button>
    {usedCategories.map((cat) => (
      <button type="button" data-category={cat} aria-pressed="false">
        <span class="swatch" style={`background:${CATEGORY_META[cat].color}`}></span>
        {CATEGORY_META[cat].label} ({categoryCounts.get(cat)})
      </button>
    ))}
  </div>

  <ol class="timeline">
    {entries.map(({ event, recollections, ownText, photos }) => (
      <li
        class="event"
        data-category={event.data.category}
        style={`--cat-color:${CATEGORY_META[event.data.category].color}`}
      >
        <p class="event-date record">
          {event.data.displayDate}
          {event.data.datePrecision !== 'exact' && (
            <span class="precision">&middot; {event.data.datePrecision}</span>
          )}
        </p>
        <div class="event-body">
          <h2>{event.data.title}</h2>
          <p class="event-meta record">{CATEGORY_META[event.data.category].label}</p>
          {SHOW_DESCRIPTIONS && <p>{event.data.description}</p>}

          {ownText && (
            <Recollection attribution={attributionForCopiedText(ownText, allRecollections)}>
              {ownText}
            </Recollection>
          )}

          {recollections.map((rec) => (
            <>
              <Recollection attribution={attributionFor(rec.data.fidelity)}>{rec.data.text}</Recollection>
              <p class="record provenance">{recordedLine(rec.data.recorded)}</p>
            </>
          ))}

          {photos.length > 0 && (
            <ul class="event-photos">
              {photos.map((photo) => (
                <li>
                  <a href={withBase(`/photos/${photo.id}/`)}>
                    <img
                      src={withBase(`/images/photos/thumbs/${photo.data.photoId}.jpg`)}
                      alt={photo.data.cataloged ? photo.data.title : `Photograph ${photo.data.photoId}`}
                      width="320"
                      height="216"
                      loading="lazy"
                    />
                    <span class="record">{photo.data.photoId}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ol>

  <MemoryBox term="timeline" subject="timeline" />
</BaseLayout>

<script>
  // Category filter chips: server-rendered but hidden; shown only when JS runs,
  // replacing the static legend. Multi-select; empty selection means "All".
  const filters = document.querySelector<HTMLElement>('.filters');
  const legend = document.querySelector<HTMLElement>('.legend');
  if (filters && legend) {
    filters.hidden = false;
    legend.hidden = true;

    const allChip = filters.querySelector<HTMLButtonElement>('button[data-all]')!;
    const chips = [...filters.querySelectorAll<HTMLButtonElement>('button[data-category]')];
    const events = [...document.querySelectorAll<HTMLElement>('.timeline .event')];
    const active = new Set<string>();

    const render = () => {
      const showAll = active.size === 0;
      allChip.setAttribute('aria-pressed', String(showAll));
      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(active.has(chip.dataset.category!)));
      }
      for (const event of events) {
        event.hidden = !showAll && !active.has(event.dataset.category!);
      }
    };

    allChip.addEventListener('click', () => {
      active.clear();
      render();
    });
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.category!;
        if (active.has(cat)) active.delete(cat);
        else active.add(cat);
        render();
      });
    }
    render();
  }
</script>

<style>
  .lede {
    font-size: 1.15rem;
  }

  .legend {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .filters {
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font: inherit;
    font-size: 0.92rem;
    padding: 0.45em 0.9em;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 2em;
    cursor: pointer;
  }

  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .filters button[aria-pressed='true'] .swatch {
    outline: 2px solid var(--paper);
  }

  .swatch {
    width: 0.7em;
    height: 0.7em;
    display: inline-block;
    border-radius: 50%;
  }

  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    border-left: 2px solid var(--line);
  }

  .event {
    position: relative;
    padding: 0 0 2.8rem 1.8rem;
  }

  .event::before {
    content: '';
    position: absolute;
    left: -0.48rem;
    top: 0.35rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--cat-color);
    border: 2px solid var(--paper);
  }

  .event h2 {
    margin: 0.2rem 0 0.4rem;
    font-size: 1.25rem;
  }

  .event-date {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
  }

  .precision {
    color: var(--khaki);
    font-weight: 400;
  }

  .event-meta {
    margin: 0 0 0.7rem;
    text-transform: none;
  }

  .event p {
    margin-top: 0;
  }

  .event-photos {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .event-photos a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .event-photos img {
    display: block;
    width: min(12rem, 100%);
    height: auto;
    border: 1px solid var(--line);
  }
</style>
