---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

// The breakfast interview guide, distilled from the AI survey
// (research/interviews/breakfast-questions.md is the working copy).
// Checkboxes persist in the browser's localStorage on whatever device
// you use at the table.
//
// Deliberately unlinked from the rest of the site and noindexed: several
// questions are probes that only work if Larry doesn't read them first.
// Reach it by direct URL / bookmark; never link it from a public page.

interface Question {
  id: string;
  q: string;
  why?: string;
  photos: string[];
  /** Film clip IDs, linked to their /footage/ pages. */
  clips?: string[];
}

const tiers: { title: string; intro?: string; questions: Question[] }[] = [
  {
    title: 'The big unlocks',
    intro: 'One per breakfast. Each answer opens a research door.',
    questions: [
      {
        id: 'is-this-you',
        q: '“Who is the young soldier under your arm on the mountain? What was in the metal cabinet behind you — your radio gear? Whose Thompson is he holding?”',
        why: 'ANSWERED 2026-08-17: “Is this you?” — yes. Larry confirmed in conversation that VN-0028 is him, anchoring the identity thread through the whole collection in his own word. The follow-ups above are what remain, plus VN-0029 which awaits its own look.',
        photos: ['vn-0028', 'vn-0029'],
      },
      {
        id: 'the-guitarist',
        q: '“It’ll come to you — who was the guitar player? The man with you and Ron at the Cholon pool.”',
        why: 'ANSWERED in part, 2026-08-15: the beach-table man is Ron Tototz. The new most-wanted name: the VN-0005 left man — someone he “knew really well” — who is also the guitarist of the VN-0003/0007/0008 sessions. One name resolves four photos. The Japan hospital friend (VN-0093) is still a separate unnamed man.',
        photos: ['vn-0005', 'vn-0003', 'vn-0007', 'vn-0008', 'vn-0093'],
      },
      {
        id: 'unit-markings',
        q: '“What was on your pocket patch — and what did your unit paint on its helicopters?”',
        why: 'The unit question: “118th AOD” vs. the 118th Aviation Company “Thunderbirds.”',
        photos: ['vn-0028', 'vn-0012', 'vn-0141'],
      },
      {
        id: 'ops-van',
        q: '“Where did the radio van stand — the company headquarters you call Thom Son Nuht? And who are the two flight controllers on the steps?”',
        why: 'ANSWERED 2026-08-23 — where the van stood: “It was over in the property of 18th aviation. They were huge. They had probably about 300 helicopters including sky cranes. It was before the first cav aviation.” A unit new to the archive, and a sequence that would explain the 1st Cavalry association without his having served in it. Still open: the two men on the steps.',
        photos: ['vn-0015', 'vn-0014', 'vn-0011'],
      },
      {
        id: 'japan-medical',
        q: '“How long were you in the hospital at Camp Zama? Did you see the Stars and Stripes piece in the ward? Was the Ginza day a pass from the hospital? And what do you remember about that German restaurant — the sign, the entrance, the stairs?”',
        why: 'ANSWERED in part, 2026-08-13, unprompted: “I was at Camp Zama in Japan in Sugami Uro” — he produced the name himself, told only that research had a candidate. The follow-ups above are what remain. On the restaurant, don’t supply details: a spontaneous “beer-barrel doorway” would identify Ketel’s.',
        photos: ['vn-0093', 'vn-0095'],
      },
      {
        id: 'roster-names',
        q: '“Do you remember these names painted on the rocks — Rewerts, Garvey, Kirby, Captain Lynch, Dean, Willcut? Was Sergeant Lowry’s name up there?”',
        why: 'The Sgt. Lowry search and the identity of the mountain site. Stricter since 2026-09-01: two of these names have been matched to real Special Forces officers in period records. Reading the names to him is fine — they came off his own photograph. Saying which two were identified, or who they were, or what they did, is not, until he has answered cold. See research/people/nui-ba-den-roster-names.md.',
        photos: ['vn-0035', 'vn-0133'],
      },
      {
        id: 'camp-called-the-mountain',
        q: '“When you were on the radio up on the mountain, did a camp ever call you while it was being attacked? What did they say, and what did you do?”',
        why: 'The sharpest probe in the guide, and it only works cold. A period document now confirms what the mountain radio station was for and records one specific call it took — so do NOT name a camp, a date, or a phrase, and let him say it first. See research/units/callsigns-and-units.md, 2026-09-01.',
        photos: [],
      },
      {
        id: 'who-ran-the-camp',
        q: '“Who was in charge up at that camp? Was there an officer — do you remember his name, or his rank?”',
        why: 'Ask this before anything else about the mountain, and supply nothing — not a rank, not an initial. Period records name the officer commanding there during his months. He has already used one surname elsewhere for a different man, so if that name comes back here, ask gently how he knows which one he means. See research/people/nui-ba-den-roster-names.md.',
        photos: [],
      },
      {
        id: 'what-the-camp-was-for',
        q: '“What was that camp on the mountain actually there for? What was its job?”',
        why: 'A period document states the site’s official mission in one phrase. If he names it unprompted, his testimony matches an official record with no help from us. Do not offer the phrase, and do not offer alternatives to choose from.',
        photos: [],
      },
      {
        id: 'other-boxing-terms',
        q: '“Were there other call signs on that net you remember — other boxing words? And what number were you?”',
        why: 'He told us unprompted that the Special Forces call signs were boxing terms, and that the camp was Body Jab 42. A period source now shows the same call word at another camp with a different number, which is why his own numbers matter. Ask open; supply nothing.',
        photos: [],
      },
      {
        id: 'burning-base',
        q: '“You photographed this fire twice from the air. What happened — was it the big Bien Hoa explosion in May ’65?”',
        why: 'A dateable documented event, and possibly the unit’s home field.',
        photos: ['vn-0074', 'vn-0078'],
      },
      {
        id: 'watch-the-film',
        q: '“Can we watch your movie film together?” — one chapter at a time, letting him narrate. “Where is this? Who’s holding the camera?”',
        why: 'Narration for all 22 minutes of film. The boulevard in VF-0005 may be his Saigon. Follow-up: do the original 8mm reels still exist? If so, a professional re-scan becomes possible.',
        photos: [],
        clips: ['vf-0001', 'vf-0002', 'vf-0003', 'vf-0004', 'vf-0005'],
      },
      {
        id: 'home-base',
        q: '“What was the name of the base where your hooch T 123 stood?”',
        why: 'Partly answered 2026-08-15: “T 123 my father says has to be their hooch” — his and Ron’s. The base’s NAME is still the missing anchor for half the collection’s geography.',
        photos: ['vn-0136', 'vn-0117', 'vn-0017'],
      },
    ],
  },
  {
    title: 'Quick confirmations',
    intro: 'Fast yes/no questions over coffee.',
    questions: [
      { id: 'mountain-radio', q: '“How did you get up the mountain — helicopter? How long were your stints? And the kid who was with you all the time — what was his name?”', why: 'The radio room is ANSWERED (2026-08-15): “This is my radio area with 3 radios.” The boy of VN-0009 — 12, shot in the leg, married at 10 — is unnamed.', photos: ['vn-0044', 'vn-0059', 'vn-0009'] },
      { id: 'beach-medic', q: '“The medic from Nebraska who went out into the water — do you remember his name, or when it happened? Was he Army, or a Navy man? Was it during your first weeks at Nha Trang in ’64, or a later trip back?”', why: 'The beach is ANSWERED (2026-08-15): Nha Trang, beach hut #3 or #4. A full casualty-file sweep (issue #61, 2026-08-16) found no Nebraska serviceman and no medic drowned in-country during his tour — his answers decide which detail to relax before re-searching. Don’t read him any names.', photos: ['vn-0021', 'vn-0022'] },
      { id: 'pool-where', q: '“Are these at the same pool — the French pool in Cholon?”', why: 'VN-0004/VN-0005 are ANSWERED (2026-08-15): the French swimming pool, Cholon. Still open whether the other pool frames match.', photos: ['vn-0075', 'vn-0083'] },
      { id: 'town-tayninh', q: '“Is this the town under the mountain — Tây Ninh?”', photos: ['vn-0055'] },
      { id: 'monument-town', q: '“Which town is this monument square in?”', photos: ['vn-0130'] },
      { id: 'crash', q: '“Whose helicopter went down here? Did everyone get out?”', photos: ['vn-0148'] },
      { id: 'saigon-trips', q: '“What took you into Saigon — duty or passes? Were you there for Tết ’65?”', photos: ['vn-0120', 'vn-0068'] },
    ],
  },
  {
    title: 'Stories & people',
    intro: 'No research agenda — pure memoir gold. Let him wander.',
    questions: [
      { id: 'guitar', q: '“Who could actually play the guitar? What did you all sing?”', why: 'He named Kahn and Ron Tototz in VN-0003 (2026-08-13); Ron was from Des Moines, Iowa, and passed away about ten years ago (2026-08-15). The guitarist himself is the VN-0005 left man — see the Tier 1 question.', photos: ['vn-0003', 'vn-0007', 'vn-0008'] },
      { id: 'rocket-launcher-day', q: '“The rocket launcher you photographed on the mountain — what happened when it fired? Did it hit the crossroad? Who was the Australian captain? And tell me about Major Schwartzkoff — what was he like?”', why: 'From his 2026-08-13 comments on VN-0006, which he took himself, ~June 1965. Just listen on the major — no name suggestions.', photos: ['vn-0006'] },
      { id: 'mother-baby', q: '“The mother and baby by your batteries on the mountain — who were they?”', photos: ['vn-0145', 'vn-0156'] },
      { id: 't122-family', q: '“The ladies next door at T 122 — laundry? cooking? What were their names?”', photos: ['vn-0155'] },
      { id: 'mascots', q: '“Was there one Jones or two — the PFC on the helicopter, and the pilot who owned Sarge the monkey? And the black gibbon — whose was he?”', why: 'The monkey is ANSWERED (2026-08-15): Sarge, whom Ron hated, maybe belonging to “Jones, the helicopter pilot.” A PFC Jones also appears in VN-0012/VN-0020.', photos: ['vn-0017', 'vn-0012', 'vn-0020', 'vn-0152'] },
      { id: 'club-nights', q: '“How often did the shows come through the club? Anyone you can name in the crowd?”', photos: ['vn-0030', 'vn-0034'] },
      { id: 'python', q: '“The day they caught the big python — did they eat it?”', photos: ['vn-0153'] },
      { id: 'thompson', q: '“Was that your Thompson on your bunk? Did you ever have to use it?”', photos: ['vn-0082', 'vn-0084'] },
      { id: 'red-ao-dai', q: '“Who is she? This one looks like it mattered.”', photos: ['vn-0154'] },
      { id: 'camera-girl', q: '“She’s holding a camera — did she take any of these pictures?”', photos: ['vn-0151'] },
      { id: 'motorcycle-days', q: '“Tell me about your motorcycle days in Inglewood — did you ever crash?”', why: 'Newspapers show two crashes: South Gate Press Sep 1, 1957 (Firestone Blvd., at ~16) and Daily Breeze Jul 10, 1959 (thrown to the pavement at Crenshaw and 120th at 18, Daniel Freeman Hospital). Let him tell it before showing the clippings — the 1959 item prints “Larry B.”, so his telling also confirms it’s him. See research/people/hunnewell-family-newspapers.md.', photos: [] },
      { id: 'basic-chapman', q: '“Where was basic training? And did you know Sgt. Chapman from training too, or just over there?”', why: 'Chapman turned out to be in VN-0024 with Larry in Vietnam, an E7 (2026-08-15) — the earlier basic-training association needs reconciling. Kennedy was shot a month into basic — “where were you when you heard?” is the way in.', photos: ['vn-0024'] },
      { id: 'mike-patrick', q: '“How did you know Mike Patrick? What was he like? And who’s the other American on the rocks at the edge?”', why: 'Named 2026-08-15 in VN-0010 — ranger, MACV special operations, “a ghost or a spook.” Ask open; let him tell it.', photos: ['vn-0010'] },
      { id: 'parr', q: '“Parr, from the Nha Trang days — what was his first name? Where was he from? Did you stay in touch?”', photos: ['vn-0025'] },
      { id: 'rosie-club', q: '“Which club did Rosie work the door at — where was it? And how do you know she made it to America?”', why: 'Named 2026-08-15. Could be a whole story.', photos: [] },
      { id: 'la-franceaous', q: '“Sergeant La Franceaous — where did you know him from? What did he do?”', photos: [] },
      { id: 'guegler-more', q: '“The officer on the left next to Captain Guegler — it may come back to you. And what was Guegler’s first name?”', photos: ['vn-0020'] },
      { id: 'rosethorn-crew', q: '“Besides Major Lewis and Captain Guegler, do you remember other pilots or crew on Rosethorn 007?”', photos: ['vn-0016'] },
      { id: 'patrol-prisoner', q: '“Tell me about that patrol — how was the prisoner captured? Did you go on many patrols with Captain Kennedy?”', why: 'From VN-0023 (2026-08-15), the photo Kennedy took of him. For a day when he’s in the mood for the heavier stories.', photos: ['vn-0023'] },
      { id: 'zekeowski', q: '“Zekeowski from Newark — what was his first name? What did he do? Best guess at the spelling?”', photos: ['vn-0027'] },
      { id: 'battalion-flightline', q: '“Do you remember which battalion your company belonged to? What other helicopter outfits flew out of Tan Son Nhut — how were their aircraft marked?”', why: 'Open questions only — don’t name any unit or describe any emblem to him. Candidate readings live in research/ files (flight-following-1964-65, magnification notes).', photos: ['vn-0012', 'vn-0020'] },
      { id: 'helicopter-suners', q: '“Tell me again about the helicopter and the explosion — the two with the bombs around them. What did you call them?”', why: 'From the August 2026 call: the word sounded like “su-ners” — if it was “sappers,” the story may match a documentable attack. Let him say the word; don’t supply it.', photos: [] },
      { id: 'va-file-number', q: '“What’s your VA file number, from the Agent Orange claim paperwork?”', why: 'ANSWERED Aug 2026 — recorded in the private archive (identifiers stay off the site). The recalled number differs by one digit from the Oct 2015 VA letter; the letter’s number goes on forms.', photos: [] },
      { id: 'more-slides', q: '“Are there more slide boxes or prints anywhere that we never scanned?”', why: 'ANSWERED Aug 2026 (family): everything Larry handed over is scanned; the 8mm footage could be re-scanned at higher quality someday.', photos: [] },
    ],
  },
];
---

<BaseLayout title="Interview Guide" noindex={true}>
  <span class="eyebrow">For the breakfast table</span>
  <h1>Questions for Dad</h1>
  <p class="lede">
    One or two of these over breakfast is plenty. Tap a photo to open it — then let him talk,
    and put what he says, word for word, into the <strong>Memories</strong> box on that photo's
    page. Never correct a memory; if it differs from the research, both get kept.
  </p>
  <p class="record">Checked boxes are remembered on this device.</p>
  <p class="glossary-note">
    Unfamiliar term in a question — a <em>van</em>, an <em>AOD</em>, a <em>hooch</em>? They're
    Larry's words, explained in the <a href={withBase('/glossary/')}>glossary</a>.
  </p>

  {tiers.map((tier) => (
    <section>
      <h2>{tier.title}</h2>
      {tier.intro && <p class="tier-intro">{tier.intro}</p>}
      <ul class="questions">
        {tier.questions.map((item) => (
          <li class="question">
            <label class="q-row">
              <input type="checkbox" class="q-check" data-id={item.id} />
              <span class="q-text">{item.q}</span>
            </label>
            {item.why && <p class="q-why">{item.why}</p>}
            {(item.photos.length > 0 || (item.clips?.length ?? 0) > 0) && (
              <p class="q-photos">
                {item.photos.map((p) => (
                  <a class="photo-chip" href={withBase(`/photos/${p}/`)}>{p.toUpperCase()}</a>
                ))}
                {item.clips?.map((c) => (
                  <a class="photo-chip" href={withBase(`/footage/${c}/`)}>&#9654; {c.toUpperCase()}</a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="held">
    <h2>Held for the right moment</h2>
    <p>
      One photograph — <strong>VN-0157</strong>, a wounded man aboard a helicopter — is not a
      breakfast question. When Dad is ready, and only then: <em>“Do you remember this man and
      this day?”</em> His answer also decides whether that photo is ever shown publicly. It is
      deliberately not linked here; it lives in the archive.
    </p>
    <p>
      The <strong>bathroom incident</strong>: the full account arrived 2026-08-15 — the man
      in the shower shot in the chest, the drunk gunman aiming at Larry, Sgt. Weaver
      responding, Air Force police taking his statement, and the sentence he heard: 20 years
      hard labor in Okinawa. Remaining gentle follow-ups: did the man in the shower live?
      Does he remember the shooter's name, or the victim's? Don't correct any detail against
      the earlier family memory; let it come as he tells it.
    </p>
  </section>

  <p class="record">
    Working copy with full notes: <span class="record">research/interviews/breakfast-questions.md</span>
    &middot; per-photo question lists: <span class="record">data/photos/ai-observations/</span>
  </p>
</BaseLayout>

<script>
  const boxes = document.querySelectorAll<HTMLInputElement>('.q-check');
  boxes.forEach((box) => {
    const key = `interview-${box.dataset.id}`;
    box.checked = localStorage.getItem(key) === '1';
    box.closest('.question')?.classList.toggle('done', box.checked);
    box.addEventListener('change', () => {
      localStorage.setItem(key, box.checked ? '1' : '0');
      box.closest('.question')?.classList.toggle('done', box.checked);
    });
  });
</script>

<style>
  .lede {
    font-size: 1.15rem;
  }

  .tier-intro {
    color: var(--ink-soft);
    margin-top: -0.4rem;
  }

  .questions {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    max-width: var(--measure);
  }

  .question {
    border: 1px solid var(--line);
    background: var(--paper-deep);
    padding: 1rem 1.1rem;
    margin-bottom: 0.9rem;
  }

  .question.done {
    opacity: 0.55;
  }

  .question.done .q-text {
    text-decoration: line-through;
    text-decoration-color: var(--khaki);
  }

  .q-row {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    cursor: pointer;
  }

  .q-check {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
    margin-top: 0.15rem;
    accent-color: var(--olive);
  }

  .q-text {
    font-size: 1.08rem;
    line-height: 1.5;
  }

  .q-why {
    margin: 0.5rem 0 0 2.5rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .q-photos {
    margin: 0.7rem 0 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .photo-chip {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1px solid var(--khaki);
    background: var(--paper);
    padding: 0.45em 0.8em;
    color: var(--ink);
  }

  .photo-chip:hover,
  .photo-chip:focus-visible {
    border-color: var(--signal);
    color: var(--signal);
  }

  .held {
    border: 1px solid var(--khaki);
    background: var(--paper-deep);
    padding: 1.2rem 1.4rem;
    max-width: var(--measure);
    margin-top: 2.5rem;
  }

  .held h2 {
    margin-top: 0;
    font-size: 1.1rem;
  }

  .held p {
    margin: 0;
  }

  .held p + p {
    margin-top: 0.8rem;
  }

  @media (max-width: 40rem) {
    .q-why,
    .q-photos {
      margin-left: 0;
    }
  }
</style>
