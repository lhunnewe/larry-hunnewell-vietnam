---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

// The breakfast interview guide, distilled from the AI survey
// (research/interviews/breakfast-questions.md is the working copy).
// Checkboxes persist in the browser's localStorage on whatever device
// you use at the table.
//
// Tiers are ordered by what the setting allows, not by when a question was
// written: tier 1 needs no photograph and works on a phone call, tier 2
// needs the picture in front of him. When a probe is answered, move it to
// the `answered` list below the same day — this page has twice gone on
// asking questions Larry had already answered.
//
// Deliberately unlinked from the rest of the site and noindexed: several
// questions are probes that only work if Larry doesn't read them first.
// Reach it by direct URL / bookmark; never link it from a public page.

interface Question {
  id: string;
  q: string;
  why?: string;
  photos: string[];
  /** Film clip IDs, linked to their /footage/ pages. */
  clips?: string[];
}

const tiers: { title: string; intro?: string; questions: Question[] }[] = [
  {
    title: 'Ask cold, ask next',
    intro:
      'No photograph needed — every one of these works on a telephone call. Ordered by what the answer unlocks. Eight probes were retired from this tier on 2026-09-03, when he answered them all in one call — including the Camp Zama date. What is left is what he did not answer, plus five new questions his answers created.',
    questions: [
      {
        id: 'zama-which-paper',
        q: '“The paper you saw your name in at Camp Zama — was that Stars and Stripes, or was it something the hospital put out? Do you remember the top of the front page, what it said? How big was it — could you fold it in your hand, or was it a full-size newspaper?”',
        why: 'ASK THIS ONE FIRST. On 2026-09-03 he described the paper for the first time: a free paper of about six pages, with the dead on the front page, right-hand side. The newspaper archive was audited the same day and his paper is definitively not in it \u2014 the subscription holds one Pacific title, and every issue in his window runs 27 to 78 pages. So this question no longer tells us where to search. It tells us what other record to go and find: if he says the hospital or the post put it out, that names a publication \u2014 a Camp Zama post sheet or hospital bulletin \u2014 which is a findable thing in Army publication holdings, and nobody has ever looked for it because nobody knew it existed. Ask it completely cold: do NOT name Stars and Stripes first, do not name any edition, and do not tell him what page the lists were on.',
        photos: [],
      },
      {
        id: 'subic-russian',
        q: '“You mentioned a Russian fellow at Subic Bay you played cards with — an archaeologist who’d got sick in Cambodia. What else do you remember about him? How many days were you in that room? Was he still there when you left?”',
        why: 'New to the archive on 2026-09-03, and the most checkable thing in the whole call. A Russian civilian archaeologist invalided out of northern Cambodia into a US naval hospital in 1965 is unusual enough to leave a trace, and it is the kind of specific detail that tends to be true. “How many days” is the real prize — it is an independent route to the medevac timing, coming at the chain from the Philippines end rather than the Japan end.',
        photos: [],
      },
      {
        id: 'days-until-flown-out',
        q: '“That last week on the mountain, with all the campfires — how long after that were you flown out? Days? Weeks?”',
        why: 'A second, independent route to the date, asked from the other direction. He gave 3 September 1965 for Camp Zama, which matches the archive’s own medevac derivation — but he offered it as “may have been” and said he was in and out of consciousness. An elapsed-time answer would corroborate or break it without ever asking him for a date again. Do NOT mention the Ia Drang valley: he anchored that week to it himself, and it does not fit his own dating. Reconciling that is our job, not his.',
        photos: [],
      },
      {
        id: 'chaplain-book',
        q: '“You said the chaplain wrote it down in a book. What sort of book was it — a ledger, a notebook, a form? Did he write it while you were standing there? Did he tell you what he was going to do about it?”',
        why: 'The only paper trail this archive has ever had for the misreport, and he volunteered it without being asked. A chaplain writing it down in September 1965 is a contemporaneous written record of Larry reporting himself alive while listed dead. Army chaplains kept activity logs and journals, and those are a records series — knowing whether it was a bound ledger or a loose form tells us which series to request, and whether anything was forwarded up. The chaplain’s name itself is gone; he was asked on 2026-09-03 and does not have it.',
        photos: ['vn-0093', 'vn-0095'],
      },
      {
        id: 'campfires-nights',
        q: '“You said that week the whole thing was lit up with campfires toward Cambodia. How many nights was it like that before the day everything happened? Did anyone come up to look — did you tell anyone besides the radio?”',
        why: 'He gave this unprompted on 2026-09-03: fifteen fires on a normal night, hundreds that week. It is the first context the archive has ever had for “450 enemy digging in” — a described build-up rather than a bare number. A night count would date that build-up, which is exactly what a records request for night surveillance imagery would need in order to name a target window. Do NOT suggest a number of nights to him.',
        photos: [],
      },
      {
        id: 'missing-photographs',
        q: '“Were there other pictures that didn’t go in with the rest — another album, a box, a folder somewhere? Did you ever give any away?”',
        why: 'Still open, and NOT answered by finding the CBC frame. The scan reconciliation shows the archive holds every frame the lab was given, numbered unbroken from E001 to E157, so anything missing was never scanned — the gap is upstream of the scanner, and only he knows where to look.',
        photos: [],
      },
      {
        id: 'medic-state',
        q: '“The medic who drowned at Nha Trang — you said Kansas or Nebraska. If you had to pick one, which feels right? Do you remember anything about him at all — where he trained, what people called him?”',
        why: 'His “Kanas or Nebraska” on 2026-09-02 loosened the anchor the entire 399-casualty sweep was built on, so that negative should be read as “no Nebraska match,” not “no match.” Kansas has never been swept. He held the other anchors firm: Army, his own unit’s medic, first couple of weeks at Nha Trang in ’64. Don’t read him any of the near-miss names.',
        photos: ['vn-0021'],
      },
    ],
  },
  {
    title: 'Needs the photograph',
    intro: 'For the table, with a tablet. Show the actual picture and let him talk.',
    questions: [
      {
        id: 'the-guitarist',
        q: '“It’ll come to you — who was the guitar player? The man with you and Ron at the Cholon pool.”',
        why: 'Still the most valuable unnamed man in the archive, and he got closer on 2026-09-02 without getting there: “Ron Tototz, Zukowski and that guy who played the guitar would go here.” So the guitarist is a fourth man in a pool group where we can already name two. One name resolves four photographs at once.',
        photos: ['vn-0005', 'vn-0003', 'vn-0007', 'vn-0008'],
      },
      {
        id: 'home-base',
        q: '“Where was this camp? What was the name of the base where your hooch T 123 stood? How long did you live there versus anywhere else?”',
        why: 'The base’s NAME is still the missing anchor for half the collection’s geography. New fixed points to place it against, all from 2026-09-02: the EM Club was “right across from my hooch,” VN-0082 was taken “right next to my hooch,” and his unit’s armory is the building in that frame with the EM Club just off the right edge.',
        photos: ['vn-0136', 'vn-0117', 'vn-0017'],
      },
      {
        id: 'unit-markings',
        q: '“What was on your pocket patch?”',
        why: 'Ask about the patch only. The helicopter half is SPENT — asked 2026-08-23 and negative in his own words: “Doesn’t recall what was on the helicopter.” He offered instead an Army-issue watch and two M-60s on the door. The patch still bears on the unit question: “118th AOD” vs. the 118th Aviation Company “Thunderbirds.”',
        photos: ['vn-0028'],
      },
      {
        id: 'is-this-you',
        q: '“Who is the young soldier under your arm on the mountain? What was in the metal cabinet behind you — your radio gear? Whose Thompson is he holding?”',
        why: 'VN-0028 is ANSWERED as him (2026-08-17); these follow-ups are what remain. Note the Thompson in VN-0082/VN-0084 is now answered and is Larry’s own — Gagne signed it out of the Special Forces armory for him — so the weapon in this frame is a separate question.',
        photos: ['vn-0028'],
      },
      {
        id: 'vn0029-helicopter',
        q: '“You said this wasn’t Rosethorn 007. Do you remember whose helicopter it was, or where you were going?”',
        why: 'Partly answered 2026-09-02: “I was in someone else helicopter in this photo. I don’t think it was Rosethorn 007.”',
        photos: ['vn-0029'],
      },
      {
        id: 'ops-van',
        q: '“Who are the two flight controllers on the steps? And what did Weaver’s pocket patch say?”',
        why: 'Where the van stood is ANSWERED 2026-08-23: “It was over in the property of 18th aviation… It was before the first cav aviation.” A unit new to the archive, and a sequence that would explain the 1st Cavalry association without his having served in it. The two men on the steps are what remain.',
        photos: ['vn-0011', 'vn-0014'],
      },
      {
        id: 'burning-base',
        q: '“You photographed this fire twice from the air. What happened here?”',
        why: 'Ask the open half first and let him date it himself before offering the May ’65 Bien Hoa explosion. A dateable documented event, and possibly the unit’s home field.',
        photos: ['vn-0074', 'vn-0078'],
      },
      {
        id: 'cbc-film-show',
        q: '“Is this the crew? Is that you?” — the candidate CBC film, finally safe to play for him.',
        why: 'The order of operations has flipped. He described the crew COLD on 2026-09-02 — three men, a 16mm camera, a reporter, Toronto or Montreal — and identified VN-0057 as his own photograph of them. That description is now on the record and cannot be contaminated, so a candidate film can be shown to him without spoiling anything. See research/events/cbc-documentary-1964-65.md.',
        photos: ['vn-0057'],
      },
      {
        id: 'watch-the-film',
        q: '“Can we watch your movie film together?” — one chapter at a time, letting him narrate. “Where is this? Who’s holding the camera?”',
        why: 'Narration for all 22 minutes of film. The boulevard in VF-0005 may be his Saigon. Follow-ups: what camera did he carry, and do the original 8mm reels still exist? If so, a professional re-scan becomes possible.',
        photos: [],
        clips: ['vf-0001', 'vf-0002', 'vf-0003', 'vf-0004', 'vf-0005'],
      },
      {
        id: 'ginza-day',
        q: '“Was the Ginza day a pass from the hospital? What do you remember about that German restaurant — the sign, the entrance, the stairs?”',
        why: 'Don’t supply details. If he spontaneously describes a giant beer-barrel doorway, that identifies Ketel’s — see research/places/ginza-heidelberg.md.',
        photos: ['vn-0095'],
      },
    ],
  },
  {
    title: 'Quick confirmations',
    intro: 'Fast yes/no questions over coffee. Most of this tier was answered on 2026-09-02.',
    questions: [
      { id: 'monument-town', q: '“You thought this was Nha Trang — does that still feel right, or could it be somewhere else?”', why: 'He answered “I think this is Nha Trang” on 2026-09-02 — tentative enough to be worth one confirmation, and no more.', photos: ['vn-0130'] },
      { id: 'gibbon', q: '“And the black gibbon — whose was he?”', why: 'The monkey is ANSWERED (2026-08-15): Sarge, whom Ron hated. The gibbon never has been.', photos: ['vn-0152'] },
      { id: 'mother-baby', q: '“The mother and baby by your batteries on the mountain — who were they? Did you ever learn what became of them?”', photos: ['vn-0145', 'vn-0156'] },
    ],
  },
  {
    title: 'Stories & people',
    intro: 'No research agenda — pure memoir gold. Let him wander.',
    questions: [
      { id: 'patrol-prisoner', q: '“Tell me about that patrol — how was the prisoner captured? How did you all know he was Pathet Lao?”', why: 'From VN-0023, the photo Kennedy took of him. He has since described drawing a BAR from the armory for a patrol with Major Schwartzkoff — worth asking whether this was that day. For a time when he’s in the mood for the heavier stories.', photos: ['vn-0023'] },
      { id: 'mike-patrick', q: '“How did you know Mike Patrick? What was he like? And who’s the other American on the rocks at the edge?”', why: 'Named 2026-08-15 in VN-0010 — ranger, MACV special operations, “a ghost or a spook.” Ask open; let him tell it.', photos: ['vn-0010'] },
      { id: 'parr', q: '“Parr, from the Nha Trang days — what was his first name? Where was he from? Did you stay in touch?”', photos: ['vn-0025'] },
      { id: 'rosie-club', q: '“Rosie who was the cashier at the EM Club — how do you know she made it to America? Did you hear from her?”', why: 'Placed on 2026-09-02: she was the club’s cashier, and Larry says she reached the United States. Of VN-0154 he said “This might be Rosie. I’m not sure who it is. Rosie were red a lot and was always dressed nice and clean.”', photos: ['vn-0154'] },
      { id: 'housekeeper-america', q: '“The one in the white top — you said you knew her name. Does it come back to you?”', why: 'From 2026-09-02: she reached the United States (Ron Tototz told him), was 27 with nine children, and her mother is the woman on the right. VN-0151 is the same housekeeper.', photos: ['vn-0151', 'vn-0155'] },
      { id: 'la-franceaous', q: '“Sergeant La Franceaous — where did you know him from? What did he do?”', photos: [] },
      { id: 'guegler-more', q: '“The officer on the left next to Captain Guegler — it may come back to you. And what was Guegler’s first name?”', why: 'The surname is settled: “Geutler” is Larry’s own spelling, asked and confirmed 2026-09-02, and the only rendering with real weight. The first name is what is left.', photos: ['vn-0020'] },
      { id: 'rosethorn-crew', q: '“Besides Major Lewis and Captain Guegler, do you remember other pilots or crew on Rosethorn 007?”', photos: ['vn-0016'] },
      { id: 'battalion-flightline', q: '“Do you remember which battalion your company belonged to? What other helicopter outfits flew out of Tan Son Nhut — how were their aircraft marked?”', why: 'Open questions only — don’t name any unit or describe any emblem to him. Candidate readings live in research/ files.', photos: ['vn-0012', 'vn-0020'] },
      { id: 'basic-chapman', q: '“Where was basic training? And did you know Sgt. Chapman from training too, or just over there?”', why: 'Chapman turned out to be in VN-0024 with Larry in Vietnam, an E7 (2026-08-15) — the earlier basic-training association needs reconciling. Kennedy was shot a month into basic — “where were you when you heard?” is the way in.', photos: ['vn-0024'] },
      { id: 'motorcycle-days', q: '“Tell me about your motorcycle days in Inglewood — did you ever crash?”', why: 'Newspapers show two crashes: South Gate Press Sep 1, 1957 and Daily Breeze Jul 10, 1959. Let him tell it before showing the clippings — the 1959 item prints “Larry B.”, so his telling also confirms it’s him.', photos: [] },
      { id: 'chris-cox', q: '“Tell me about Chris Cox — how did you know him?”', why: 'Volunteered 2026-09-02: he named his son Chris after Chris Cox, who owned Agrotech Machine and rode with the Prospectors motorcycle club, and took the middle name from Ian Fleming. Family history rather than Vietnam, and worth having in his own words.', photos: [] },
      { id: 'the-music', q: '“What else did you listen to over there? Where did you get the records?”', why: 'From VN-0084: he kept a stereo between his bunk and Ron’s, playing Mantovani, Ferrante & Teicher and Peter Nero, with an Ian Fleming paperback to hand.', photos: ['vn-0084'] },
    ],
  },
];

// Spent probes. Kept visible so nobody asks them again, and so the reasoning
// survives. Full record: research/interviews/breakfast-questions.md.
const answered: { q: string; a: string }[] = [
  {
    q: 'What date did you get to Camp Zama?',
    a: '2026-09-03, and it is the answer to the archive’s most-wanted fact: “He says Camp Zama may have been 9/3/1965. He said he was kind of in and out of it.” Held loosely — “may have been”, and in and out of consciousness is how dates blur — but it independently matches the archive’s own derivation, which had worked the medevac chain backwards from “early September” to a last day on the mountain of 25–27 August. He added something nobody asked for: at Subic Bay he shared a room with a Russian archaeologist invalided out of northern Cambodia, and “We played cards together.”',
  },
  {
    q: 'What paper did you read at Camp Zama?',
    a: '2026-09-03: “They were a free news paper, like 6 pages. I think the first page on the right side was 40 guys killed.” This reversed a conclusion the archive had reached the same morning. The digitised Pacific Stars and Stripes runs 24 to 37 pages with casualty lists on inside pages, so a six-page paper with the dead on page one is a different publication — and the question is back at the head of the tier above, rephrased.',
  },
  {
    q: 'The interpreter — his name, or his rank?',
    a: '2026-09-03, asked cold, and the probe did not fire — which is itself a clean result. He did not separate a rank from the name and said he does not know Vietnamese ranks: “He seemed more of a buddhist than a soldier. Phonetically he says something like Trang-Zee-Nee-Yot-Na-Yong.” Not the independent confirmation the question was built to produce, and it must not be written up as one. What it gives is a second phonetic rendering, a year on from the first, that maps onto the same sounds.',
  },
  {
    q: 'Gagne — what became of him after you were flown out?',
    a: '2026-09-03: “I have no idea. He could still be alive for all I know.” No hint that he ever heard of a death — consistent with his 2026-09-02 correction, and not with the 2026-09-01 account. All three stand.',
  },
  {
    q: 'Was Kennedy always the one in charge?',
    a: '2026-09-03, asked with the other name deliberately withheld — and he supplied it himself: “Kennedy pretty much ran the camp. When he was gone, Lowry ran the camp. Kennedy wasn’t there that last week when all the shit happened.” The most productive answer in the call. He went on, unprompted, to the campfires: fifteen on a normal night looking west into Cambodia, “hundreds and hundreds” that week, “and we had Mohawk airplane flying this everynight with infared.”',
  },
  {
    q: 'The chaplain at Camp Zama — his name?',
    a: '2026-09-03: “I don’t know the Chaplains name. He wrote it down in a book.” The name is lost; the second sentence is the find, and the follow-up is live in the tier above.',
  },
  {
    q: 'The bar on Tu Do street — when was the explosion?',
    a: '2026-09-03, and it dates an event the archive could not place: “About in the middle of the tour. The US Embassy is what was blown up… I was about a block away, I think I was at the Papillon and it rocked the building when it went off.” Note he spells the bar Papillon here and Papallon on 2026-09-02 — both are his.',
  },
  {
    q: 'The burnt helicopter — did you see it happen?',
    a: '2026-09-03, asked plainly, and he confirmed what the archive had reasoned but could not test: “It was already there when I got to Vietnam. After the CBC people. After the rocket launch.” So the wreck predates him, the search window moves back years, and “7 guys dead, burnt for 3 hours” is what he was told rather than what he saw.',
  },
  {
    q: 'Spell Zukowski.',
    a: '2026-09-03: “Zukowski. I don’t know the first name. No one went by first name in the military.” The spelling now carries his own authority — the third in the archive after “Ton Son Nuht” and “Geutler”. The second sentence explains why so many of the men here are surnames only.',
  },
  {
    q: 'Gagne — was he French, and where did he die?',
    a: '2026-09-02, and it reverses the premise: “No - he did not die. He was still alive when I got medivac out.” On 2026-09-01 he had said Gagne died. Both records stand and neither is corrected. French “pretty sure,” immediately widened to “He could have been born in Germany or Belgium, I don’t know.” And he is placed at last: Gagne ran the Special Forces armory and signed out the Thompson in VN-0082 for him.',
  },
  {
    q: 'Where were you sitting when Đồng Xoài was hit?',
    a: '2026-09-02: “On top the radio mountain.” With a reason nobody asked for — “They couldn’t get Saigon because there was no direct path and the ran and wind was blowing 100 mph… There was no aircraft up to help the guys at Dong Xoai at all, everything was grounded. That’s why the Vietcong attacked because they knew none of the helicopters could fly.”',
  },
  {
    q: 'The names painted on the rocks — VN-0035.',
    a: '2026-09-02, seven clean negatives: Rewerts, Garvey, Kirby, Captain Lynch, Dean, Willcut and Lowry — N to all seven. “These names were there when I arrived. I didn’t know any of them. The names on the left are probably special forces.” This closes the standing instruction to check Sgt. Lowry’s name against the rock.',
  },
  {
    q: 'The KIA report, and the 450 civilians.',
    a: '2026-09-02, told end to end for the first time, and they are one story. A helicopter spotted “about 450 of them digging defensive positions” — enemy, not civilians — Sgt Lowery came back an hour later with the accusation, and “Somebody up there, probably Sgt Lowery, probably reported me KIA.” Then the medevac chain: Captain Geutler flew him off the mountain and dropped Sgt. Weaver in his place; yellow jaundice; ~3 days in Cholon; 4–5 days at Subic Bay; then Camp Zama, where “In the first 3-4 days I saw the name in the KIA list and went straight to the chaplin.” Do not go back at this for detail unless he opens it himself.',
  },
  {
    q: 'The CBC crew, and the CBC pictures.',
    a: '2026-09-02, both answered cold: three men 25–35, a full-size 16mm camera, “Yes a new reporter” as well as a cameraman, “Toronto or Montreal. Just a guess,” filmed on Núi Bà Đen fifty to a hundred yards below the point, Nov or Dec 1964 — and the photograph is VN-0057, which the archive had swept for and missed. “I took the photo. The other 4 are Cambodians coming back from patrol.”',
  },
  {
    q: 'The mountain, day to day — and the boy at the fort.',
    a: '2026-09-02: “Got there by Helicopter. The stints were a week or 10 days. Sometimes I would take 2 of them back to back. I liked it there. It was safer there.” The boy of VN-0009 has now been asked twice and is a settled negative: “I don’t remember the kids name. He was shot twice I think in the leg.”',
  },
  {
    q: 'What was the camp for, who ran it, and what was it called?',
    a: 'The cold probes of 2026-09-01. Mission: “The best place to have readios because it was high” — matching an order of battle that prints “MISSION: RADIO RELAY,” which he had never seen. In charge: “Captain Kennedy was in Charge of the camp most of the time. But I really worked for 1st Cavalry.” Name: “They called the camp The Mountain.” Call signs: “Body Jab 42, Right Cross, Upper Cut… Major Schartkoff was in charge of them,” with Uppercut already on this archive’s written list of predicted siblings.',
  },
  {
    q: 'Tết, the pool, the town, the club, the python, the Thompson.',
    a: 'All answered 2026-09-02. Tết: “When tet happened when I was there I was up in the mountain” — not Saigon. VN-0075 and VN-0083: the French Pool in Cholon. VN-0055: not Tây Ninh but “Ton Suhn Nhut intersection.” VN-0030/0031: the EM Club, across from his hooch, a show almost every night, officers not allowed, drinks ten cents. VN-0153: the python at the very top of the mountain, caught by “my Cambodians guys” — “When you are eating sea rations, anything is good.” VN-0082/0084: his own Thompson, his bunk, Ron on the right.',
  },
  {
    q: 'What did you call the men with the bombs around them?',
    a: 'Answered 2026-08-23, and he said the word himself, unprompted: “They were called Sappers.” He added that there were sappers as young as ten. The probe is spent and the term is no longer withheld.',
  },
  {
    q: 'Your service number, VA file number, and the slides.',
    a: 'All answered Aug 2026 and recorded privately — identifiers stay off the site. The service number contains no 42, and Larry said directly that the camp call sign is why he uses that number. The recalled VA number differs by one digit from the Oct 2015 letter; the letter’s number goes on forms. Everything Larry handed over was scanned, and a friend at Longs Drugs did the developing for free.',
  },
];
---

<BaseLayout title="Interview Guide" noindex={true}>
  <span class="eyebrow">For the breakfast table</span>
  <h1>Questions for Dad</h1>
  <p class="lede">
    One or two of these over breakfast is plenty. Tap a photo to open it — then let him talk,
    and put what he says, word for word, into the <strong>Memories</strong> box on that photo's
    page. Never correct a memory; if it differs from the research, both get kept.
  </p>
  <p class="record">Checked boxes are remembered on this device.</p>
  <p class="glossary-note">
    Unfamiliar term in a question — a <em>van</em>, an <em>AOD</em>, a <em>hooch</em>? They're
    Larry's words, explained in the <a href={withBase('/glossary/')}>glossary</a>.
  </p>

  <section class="ten-minutes">
    <h2>If you only get ten minutes</h2>
    <ol>
      <li><strong>What date did you get to Camp Zama?</strong> — <em>anything that fixes it. This is the one.</em></li>
      <li><strong>The interpreter at the burnt helicopter</strong> — what did you all call him? <em>(blocks a search)</em></li>
      <li><strong>Gagne</strong> — what became of him after you were flown out?</li>
      <li><strong>Was Kennedy always the one in charge?</strong> <em>(don't offer the other name)</em></li>
      <li><strong>The bar on Tu Do street</strong> — roughly when was the explosion?</li>
    </ol>
  </section>

  {tiers.map((tier) => (
    <section>
      <h2>{tier.title}</h2>
      {tier.intro && <p class="tier-intro">{tier.intro}</p>}
      <ul class="questions">
        {tier.questions.map((item) => (
          <li class="question">
            <label class="q-row">
              <input type="checkbox" class="q-check" data-id={item.id} />
              <span class="q-text">{item.q}</span>
            </label>
            {item.why && <p class="q-why">{item.why}</p>}
            {(item.photos.length > 0 || (item.clips?.length ?? 0) > 0) && (
              <p class="q-photos">
                {item.photos.map((p) => (
                  <a class="photo-chip" href={withBase(`/photos/${p}/`)}>{p.toUpperCase()}</a>
                ))}
                {item.clips?.map((c) => (
                  <a class="photo-chip" href={withBase(`/footage/${c}/`)}>&#9654; {c.toUpperCase()}</a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="held">
    <h2>Held for the right moment</h2>
    <p>
      One photograph — <strong>VN-0157</strong>, a wounded man aboard a helicopter — is not a
      breakfast question. When Dad is ready, and only then: <em>“Do you remember this man and
      this day?”</em> His answer also decides whether that photo is ever shown publicly. It is
      deliberately not linked here; it lives in the archive.
    </p>
    <p>
      The <strong>bathroom incident</strong>: the full account arrived 2026-08-15 — the man
      in the shower shot in the chest, the drunk gunman aiming at Larry, Sgt. Weaver
      responding, Air Force police taking his statement, and the sentence he heard: 20 years
      hard labor in Okinawa. Remaining gentle follow-ups: did the man in the shower live?
      Does he remember the shooter's name, or the victim's? Don't correct any detail against
      the earlier family memory; let it come as he tells it.
    </p>
  </section>

  <section class="answered">
    <h2>Already answered — don't ask again</h2>
    <p class="tier-intro">
      Spent probes, kept visible so nobody re-asks them and so the reasoning survives. The
      follow-ups they created are live questions in the tiers above.
    </p>
    <dl>
      {answered.map((item) => (
        <div class="answered-item">
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <p class="record">
    Working copy with full notes: <span class="record">research/interviews/breakfast-questions.md</span>
    &middot; per-photo question lists: <span class="record">data/photos/ai-observations/</span>
  </p>
</BaseLayout>

<script>
  const boxes = document.querySelectorAll<HTMLInputElement>('.q-check');
  boxes.forEach((box) => {
    const key = `interview-${box.dataset.id}`;
    box.checked = localStorage.getItem(key) === '1';
    box.closest('.question')?.classList.toggle('done', box.checked);
    box.addEventListener('change', () => {
      localStorage.setItem(key, box.checked ? '1' : '0');
      box.closest('.question')?.classList.toggle('done', box.checked);
    });
  });
</script>

