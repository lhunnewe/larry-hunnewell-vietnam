---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

// Deliberately short. Until his service file comes back, the home page makes
// no claim about his unit, his duties, his dates or his travels: the
// photographs, the film and his own words carry the site. The earlier home
// page (service box, unit paragraph) is in git history.
const areas = [
  {
    href: '/photos/',
    title: 'Photographs',
    text: 'The 157 photographs he brought home, scanned and numbered.',
  },
  {
    href: '/footage/',
    title: 'Film Footage',
    text: 'His 8mm movie film.',
  },
  {
    href: '/drawings/',
    title: 'Drawings',
    text: 'Places he remembers, drawn in his own hand.',
  },
  {
    href: '/memories/',
    title: 'Tell a Story',
    text: 'A place for any memory, with or without a picture.',
  },
];
---

<BaseLayout title="My Father in Vietnam">
  <section class="hero">
    <span class="eyebrow">A son's record of his father's war</span>
    <h1>My Father<br />in Vietnam</h1>
    <p class="lede">
      Larry Dennis Hunnewell served in the U.S. Army in Vietnam in 1964 and 1965. He brought home
      photographs and 8mm film. This site keeps them, and what he remembers about them, in his own
      words.
    </p>
  </section>

  <ul class="card-grid">
    {areas.map((area) => (
      <li class="card">
        <h3><a href={withBase(area.href)}>{area.title}</a></h3>
        <p>{area.text}</p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 1.5rem;
  }

  .lede {
    font-size: 1.18rem;
  }
</style>
