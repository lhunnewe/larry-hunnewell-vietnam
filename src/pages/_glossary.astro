---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

// Military and period terms used across the archive. Definitions are written for family
// readers; the terms are kept exactly as Larry and the records use them.
//
// Parked 2026-09-14 (research/site-audit-2026-09-14.md) and rewritten the same day so that
// restoring it is a rename. Rules for this page, because Larry reads it: define a term from
// his own words or a document, never from the machine reading of a photograph; name no unit
// designation (his unit is an open question put to him cold); describe no emblem or patch;
// no health or benefits details; link no parked section except research and sources.

interface Term {
  id: string;
  term: string;
  expansion?: string;
  def: string;
  photos?: string[];
  link?: { href: string; label: string };
}

const sections: { title: string; terms: Term[] }[] = [
  {
    title: 'His job',
    terms: [
      {
        id: 'radio-teletype-operator',
        term: 'Radio teletype operator',
        def: 'The military specialty on Larry\'s discharge paper: sending and receiving messages over radio circuits by teletype, a typewriter that transmits over the air. The paper records the Army signal course he took for it in 1964 as 15 weeks long. On the mountain he had, in his words, "my radio area with 3 radios."',
        photos: ['vn-0059'],
      },
      {
        id: 'flight-controller',
        term: 'Flight controller',
        def: 'Larry\'s own word for his job, and for the two men on the steps of the radio van in VN-0011: "these two guys are flight controllers. I was a flight controller also."',
        photos: ['vn-0011'],
      },
      {
        id: 'van',
        term: 'Van',
        expansion: 'radio van',
        def: 'Not a road vehicle. In the Army signal world a "van" is a rigid box-body shelter, hauled by truck or set on the ground, fitted out inside as a radio room or operations center. VN-0011 shows the outside of the van Larry did his radio work in, and VN-0014 the inside; in VN-0015 he is starting a twelve-hour night shift there alone.',
        photos: ['vn-0011', 'vn-0014', 'vn-0015'],
      },
    ],
  },
  {
    title: 'Around the camps',
    terms: [
      {
        id: 'hooch',
        term: 'Hooch',
        def: 'G.I. slang for the huts and barracks soldiers lived in. Larry\'s was T 123: "T123 is my hooch."',
        photos: ['vn-0017', 'vn-0019'],
      },
      {
        id: 'thompson',
        term: 'Thompson',
        def: 'The Thompson submachine gun — the .45-caliber "Tommy gun" of Second World War fame, still in use in the early years of Vietnam. Larry\'s own appears in VN-0082 and VN-0084.',
        photos: ['vn-0082', 'vn-0084'],
      },
      {
        id: 'name-tape',
        term: 'Name tape',
        def: 'The cloth strip sewn above a uniform shirt pocket carrying the soldier\'s surname. A tape can help put a name to a face, but the names in this archive come from Larry: he confirmed that VN-0028 is him on 17 August 2026, and named the man in VN-0014 as Sgt. Weaver on 15 August 2026.',
        photos: ['vn-0028', 'vn-0014'],
      },
      {
        id: 'stars-and-stripes',
        term: 'Stars and Stripes',
        def: 'The U.S. military\'s own daily newspaper, printed for service members overseas. In the Army hospital in Japan in 1965, Larry saw himself listed in it as killed in action — the story at the center of this archive.',
        link: { href: '/research/', label: 'Research' },
      },
      {
        id: 'apo',
        term: 'APO',
        expansion: 'Army Post Office',
        def: 'The military\'s overseas mail system — units abroad are addressed by APO number rather than city and country. Larry\'s discharge paper records his last assignment under an APO number that served Camp Zama, Japan.',
      },
    ],
  },
  {
    title: 'Words from Vietnam',
    terms: [
      {
        id: 'tet',
        term: 'Tết',
        def: 'The Vietnamese Lunar New Year, the country\'s biggest holiday. Larry says that when Tết came during his tour, he was up on the mountain.',
      },
    ],
  },
  {
    title: 'The paper trail',
    terms: [
      {
        id: 'service-records',
        term: 'DD-214, SF-180, NPRC',
        expansion: 'service records',
        def: 'The DD-214 is the one-page paper every soldier receives on leaving the service: dates, specialty, decorations, last assignment. The family\'s copy of Larry\'s turned up in August 2026; it names his last assignment, in Japan, but not his unit in Vietnam. The SF-180 is the form a veteran signs to ask the National Personnel Records Center (NPRC), in St. Louis, for his full service file. Larry\'s was mailed on 17 August 2026 and its delivery was confirmed in September; no reply has come yet. A veteran\'s claim file at the VA, kept under a VA file number, can hold copies of some of the same records.',
        link: { href: '/research/', label: 'Research' },
      },
      {
        id: 'service-number',
        term: 'Service number',
        def: 'Before Social Security numbers were used, every soldier had a service number — and its prefix told a story: "US" meant drafted, "RA" meant Regular Army volunteer. Larry\'s number is kept in the family\'s own papers, not on this site.',
      },
    ],
  },
];
---

<BaseLayout
  title="Glossary"
  description="Military and period terms used in the archive, explained for family readers."
>
  <span class="eyebrow">The words explained</span>
  <h1>Glossary</h1>
  <p class="lede">
    The pages of this archive keep Larry's own vocabulary — the words he and the Army used in
    1964. This page explains those terms for everyone else. A "van" here is not what it is on
    the highway.
  </p>

  {sections.map((section) => (
    <section>
      <h2>{section.title}</h2>
      <dl class="terms">
        {section.terms.map((t) => (
          <div class="term" id={t.id}>
            <dt>
              {t.term}
              {t.expansion && <span class="record expansion">{t.expansion}</span>}
            </dt>
            <dd>
              <p>{t.def}</p>
              {(t.photos?.length || t.link) && (
                <p class="q-photos">
                  {t.photos?.map((p) => (
                    <a class="photo-chip" href={withBase(`/photos/${p}/`)}>{p.toUpperCase()}</a>
                  ))}
                  {t.link && (
                    <a class="photo-chip" href={withBase(t.link.href)}>{t.link.label} →</a>
                  )}
                </p>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <p class="record footer-note">
    Terms are defined as Larry's era used them
  </p>
</BaseLayout>

<style>
  .lede {
    font-size: 1.15rem;
  }

  .terms {
    margin: 1.2rem 0 0;
    max-width: var(--measure);
  }

  .term {
    border-bottom: 1px solid var(--line);
    padding: 1.1rem 0;
    scroll-margin-top: 1.5rem;
  }

  /* Highlight the entry a link landed on. */
  .term:target {
    background: var(--paper-deep);
    box-shadow: 0 0 0 0.6rem var(--paper-deep);
    border-left: 3px solid var(--signal);
    padding-left: 0.9rem;
  }

  .term dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .expansion {
    text-transform: none;
    letter-spacing: 0.05em;
  }

  .term dd {
    margin: 0.5rem 0 0;
  }

  .term dd p {
    margin: 0;
  }

  .q-photos {
    margin-top: 0.7rem !important;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .photo-chip {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1px solid var(--khaki);
    background: var(--paper);
    padding: 0.45em 0.8em;
    color: var(--ink);
  }

  .photo-chip:hover,
  .photo-chip:focus-visible {
    border-color: var(--signal);
    color: var(--signal);
  }

  .footer-note {
    margin-top: 3rem;
  }
</style>
