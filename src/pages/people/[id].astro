---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import Recollection from '../../components/Recollection.astro';
import MemoryBox from '../../components/MemoryBox.astro';
import Citations from '../../components/Citations.astro';
import { withBase } from '../../lib/paths';
import { attributionFor, fidelityOfCopiedText } from '../../lib/testimony';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({ params: { id: person.id }, props: { person } }));
}

const { person } = Astro.props;
const d = person.data;
/** Every recollection, so copied testimony can be attributed by its true fidelity. */
const allRecollections = await getCollection("recollections");

/** Testimony recorded about this person, with its own fidelity and provenance. */
const personRecollections = allRecollections.filter((r) =>
  (r.data.relatedPeople ?? []).some((x) => x.id === person.id)
);
---

<BaseLayout title={d.name}>
  <span class="eyebrow">Person{d.status === 'unresolved' ? ' — identity unresolved' : ''}</span>
  <h1>{d.name}</h1>
  {d.role && <p class="record">{d.role}</p>}
  <p><EvidenceBadge level={d.confidence} /></p>

  {d.aliases.length > 0 && (
    <p class="record">Spellings under investigation: {d.aliases.join(' · ')}</p>
  )}

  <p class="lede">{d.summary}</p>

  {d.larrysRecollection && (
    <Recollection attribution={attributionFor(fidelityOfCopiedText(d.larrysRecollection, allRecollections))}>
      {d.larrysRecollection}
    </Recollection>
  )}

  {personRecollections.length > 0 && (
    <>
      {personRecollections.map((rec) => (
        <>
          <Recollection attribution={attributionFor(rec.data.fidelity)}>{rec.data.text}</Recollection>
          <p class="record provenance">{rec.data.provenance}</p>
        </>
      ))}
    </>
  )}

  {d.researchNotes && (
    <>
      <h2>Research notes</h2>
      <p>{d.researchNotes}</p>
    </>
  )}

  <Citations sources={d.sources} />

  {d.relatedPlaces.length > 0 && (
    <>
      <h2>Related places</h2>
      <ul>
        {d.relatedPlaces.map((p) => (
          <li><a href={withBase(`/places/${p.id}/`)}>{p.id}</a></li>
        ))}
      </ul>
    </>
  )}

  <p><a href={withBase('/people/')}>&larr; All people</a></p>

  <MemoryBox term={`person:${person.id}`} subject="person" />
</BaseLayout>

<style>
  .lede {
    font-size: 1.15rem;
  }
</style>
